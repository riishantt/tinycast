<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>TinycastURLScheme</key>
	<string>$(TINYCAST_URL_SCHEME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Raycast and Tinycast URL Scheme</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>raycast</string>
				<string>$(TINYCAST_URL_SCHEME)</string>
				<string>com.raycast</string>
			</array>
		</dict>
	</array>
	<!-- Alternate, so Tinycast is offered under Open With but only the user makes it the default. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>public.text</string>
				<string>com.apple.rtfd</string>
				<string>com.apple.webarchive</string>
				<string>com.microsoft.word.doc</string>
				<string>org.openxmlformats.wordprocessingml.document</string>
				<string>org.openxmlformats.wordprocessingml.document.macroenabled</string>
				<string>org.openxmlformats.wordprocessingml.template</string>
				<string>org.oasis-open.opendocument.text</string>
				<string>com.microsoft.excel.xls</string>
				<string>org.openxmlformats.spreadsheetml.sheet</string>
				<string>org.openxmlformats.spreadsheetml.sheet.macroenabled</string>
				<string>com.microsoft.powerpoint.ppt</string>
				<string>org.openxmlformats.presentationml.presentation</string>
				<string>org.openxmlformats.presentationml.presentation.macroenabled</string>
				<string>org.openxmlformats.presentationml.slideshow</string>
				<string>com.apple.iwork.pages.sffpages</string>
				<string>com.apple.iwork.pages.pages</string>
				<string>com.apple.iwork.numbers.sffnumbers</string>
				<string>com.apple.iwork.numbers.numbers</string>
				<string>com.apple.iwork.keynote.sffkey</string>
				<string>com.apple.iwork.keynote.key</string>
			</array>
		</dict>
	</array>
	<!-- Exported, but deliberately never a document type: claiming the type would make a
	     double-clicked .tinycast launch straight into writing over someone's data. The identifier
	     is fixed rather than per-channel so Dev and stable can read each other's exports. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.tinycast.backup</string>
			<key>UTTypeDescription</key>
			<string>Tinycast Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tinycast</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAutoFillRequiresTextContentTypeForOneTimeCodeOnMac</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Tinycast uses automation to perform system actions you explicitly run.</string>
	<key>NSCameraUsageDescription</key>
	<string>Tinycast shows a camera preview so you can check yourself, and take a photo to the clipboard.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Tinycast records audio only while you use Dictation, to transcribe it on your Mac.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Tinycast accesses your events to show your schedule and let you join meetings.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Tinycast lets extensions you run read and edit your reminders.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Tinycast uses Bluetooth access only when you run the Toggle Bluetooth action.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Tinycast</string>
	<key>TinycastUpdatePublicKey</key>
	<string>CSzrQKht5GxZW2nVLbWEunvUChqDkeFLP64xSQRWN9E=</string>
</dict>
</plist>
